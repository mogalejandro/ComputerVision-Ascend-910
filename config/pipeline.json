{
    "pipeline": {
        "stream_name": "vision_stream",
        "plugins": [
            {
                "name": "video_decoder",
                "plugin_name": "mxpi_videodecoder",
                "props": {
                    "image_height": 640,
                    "image_width": 640,
                    "device_id": 0
                }
            },
            {
                "name": "inference",
                "plugin_name": "mxpi_tensorinfer",
                "props": {
                    "model_path": "../models/yolov11.om",
                    "device_id": 0
                }
            },
            {
                "name": "postprocess",
                "plugin_name": "mxpi_objectpostprocessor",
                "props": {
                    "class_names_file": "../config/coco.names",
                    "confidence_threshold": 0.5,
                    "nms_threshold": 0.45
                }
            }
        ]
    }
}
